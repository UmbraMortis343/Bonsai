<?xml version="1.0" encoding="utf-8"?>
<!-- The Today widget: the streak, then today's state (ochre: how many are left; green: done) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/w_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/ink"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/w_days"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:text="@string/days"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_wait"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/w_wait"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="10 left"
        android:textColor="@color/bg"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/w_done"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="@string/done"
        android:textColor="@color/accent_ink"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/w_none"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="–"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="visible" />
</LinearLayout>

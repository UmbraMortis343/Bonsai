{
  "name": "bonsai-desktop",
  "productName": "Bonsai",
  "version": "0.1.0",
  "description": "Bonsai on Windows: the live app in its own window, with Claude Code on this computer for Grow and Flesh out.",
  "author": "UmbraMortis343",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "beta": "electron . --beta",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.umbramortis343.bonsai",
    "productName": "Bonsai",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "claude.js", "build/icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bonsai",
      "include": "build/installer.nsh",
      "artifactName": "Bonsai-Setup-${version}.${ext}"
    },
    "publish": null
  }
}
